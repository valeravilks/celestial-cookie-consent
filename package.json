{
  "name": "celestial-cookie-consent",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "build": "npm run build:block && npm run build:backend",
    "build:block": "wp-scripts build --experimental-modules --source-path=src/block --output-path=build/block",
    "build:backend": "wp-scripts build --source-path=src/backend --output-path=build/backend",
    "start:block": "wp-scripts start --experimental-modules --source-path=src/block --output-path=build/block",
    "start:backend": "wp-scripts start --source-path=src/backend --output-path=build/backend",
    "env": "wp-env"
  },
  "devDependencies": {
    "@wordpress/env": "^12.2.0",
    "@wordpress/scripts": "^37.2.0"
  }
}
