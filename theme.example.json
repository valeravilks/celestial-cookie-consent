      "celestial-cookie-consent/banner": {
        "css": "--ccc-switch-accent: #1764d8;",
        "typography": {
          "fontSize": "0.9375rem",
          "lineHeight": "1.5"
        },
        "elements": {
          "h2": {
            "typography": {
              "fontSize": "1.25rem",
